  "rules": [
    {
      "kode": "R1",
      "if": "C2≥20 minggu AND C3≥140 AND C4≥90 AND C5=Negatif AND C13=Tidak",
      "then": "A2 - Hipertensi Gestasional",
      "ket": "Hipertensi baru muncul setelah 20 minggu tanpa proteinuria"
    },
    {
      "kode": "R2",
      "if": "C2<20 minggu AND C3≥140 AND C4≥90",
      "then": "A3 - Hipertensi Kronis",
      "ket": "Hipertensi sudah ada sebelum usia kehamilan 20 minggu"
    },
    {
      "kode": "R3",
      "if": "C2≥20 minggu AND C3≥140 AND C4≥90 AND C5≥+1",
      "then": "A4 - Preeklampsia Ringan",
      "ket": "Hipertensi disertai proteinuria setelah 20 minggu"
    },
    {
      "kode": "R4",
      "if": "A4 terpenuhi AND (C3≥160 OR C4≥110) AND (C7 OR C8 OR C9 OR C10 OR C11 OR C12)",
      "then": "A5 - Preeklampsia Berat",
      "ket": "Preeklampsia ringan berkembang dengan tekanan darah sangat tinggi dan/atau gejala berat (relasi OR pada gejala)"
    },
    {
      "kode": "R5",
      "if": "A5 terpenuhi AND C15=Ya",
      "then": "A7 - Eklampsia",
      "ket": "Preeklampsia berat disertai kejang - kondisi gawat darurat"
    },
    {
      "kode": "R6",
      "if": "C13=Ya AND C2≥20 minggu AND C5≥+1 (baru muncul)",
      "then": "A6 - Superimposed Preeclampsia",
      "ket": "Ibu dengan riwayat hipertensi kronis mengalami proteinuria baru"
    }
  ],
